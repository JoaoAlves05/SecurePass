{
  "manifest_version": 3,
  "name": "SecurePass",
  "description": "Analyze, generate, and protect passwords directly in your browser.",
  "version": "0.2.0",
  "action": {
    "default_title": "SecurePass",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "offscreen",
    "clipboardWrite",
    "idle",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://api.pwnedpasswords.com/*"
  ],
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/formAnalyzer.js",
        "content/modules/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; connect-src 'self' https://api.pwnedpasswords.com; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  },
  "minimum_chrome_version": "122",
  "incognito": "not_allowed"
}
